# PostgreSQL-anslutning (Prisma)
DATABASE_URL="postgresql://golfcart:CHANGE_ME@db:5432/golfcart"

# Hemlighet för Auth.js-sessioner. Generera med: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# Krävs bakom reverse proxy (Caddy/nginx) – Auth.js litar på Host-headern.
AUTH_TRUST_HOST="true"

# Betalprovider: "manual-swish" (Fas 1), "mock" (test), "swish" (Fas 2, ej implementerad än)
PAYMENT_PROVIDER="manual-swish"

# Används av docker-compose för Postgres-containern
POSTGRES_USER="golfcart"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="golfcart"

# Valfritt: lösenord för admin-kontot som skapas av seed-skriptet
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME"
